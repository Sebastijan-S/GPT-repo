+
+/* Focused week-one content and contact refinements. */
+.call-note { margin-top: 1rem; color: var(--muted); font-size: .9rem; }
+.stat-label { line-height: 1.5; }
+.contact-details p + p { margin-top: 1.2rem; }
+.contact-address { user-select: text; overflow-wrap: anywhere; }
+.contact-details a:not(.btn-primary) { color: inherit; text-underline-offset: .2em; }
+.contact-details .btn-primary { white-space: normal; text-align: center; }
+.modal-copy { margin-top: 1.5rem; }
+.modal-call { margin-top: 1.5rem; }
+.fallback-nav { position: relative; display: flex; flex-wrap: wrap; gap: 1rem; padding: 6rem 5vw 1rem; }
+.fallback-nav a { color: var(--ink); }
+.project-card .card-tag { line-height: 1.5; }
+:is(section, .hero, #team, h1, h2)[id], section h2 { scroll-margin-top: 6rem; }
+@media (max-width: 900px) {
+  .nav-cta { white-space: normal; }
+  .mobile-nav .btn-primary { white-space: normal; text-align: center; }
+  .mobile-cta .btn-primary { white-space: normal; line-height: 1.4; }
+  body.landing-page footer { padding-bottom: 7rem; }
+  .project-modal .modal-panel { max-height: 90dvh; }
+}
+
+.site-ready .fallback-navigation { display: none; }
+html:not(.site-ready) .nav-toggle, html:not(.site-ready) .card-open { display: none; }
+.contact-inner { gap: 3rem; }
+.contact-inner h2 { font-size: clamp(2rem, 4vw, 3.5rem); }
+.modal-call { white-space: normal; text-align: center; }
+
+.contact-inner { grid-template-columns: 1.1fr 1fr; }
+.contact-details { gap: 1.2rem; }
+.contact-details p, .contact-details p + p { margin-top: 0; }
+.contact-band .btn-primary { background: var(--bg); color: var(--ink); }
+.contact-band .btn-primary:hover { background: var(--stone); }
+@media (max-width: 900px) { .contact-inner { grid-template-columns: 1fr; } }
+
+/* The no-script fallback must not shift page content when enhancement starts. */
+.fallback-navigation { position: absolute; top: 4rem; left: 0; right: 0; z-index: 90; background: var(--bg); }
+.fallback-nav { position: static; padding: 1rem 5vw; }
+
+/* Browser feedback: complete service grid and compact contact hierarchy. */
+.help-platform { background: rgba(98,70,234,.06); border-color: var(--accent); display: flex; flex-direction: column; justify-content: center; }
+.platform-note-label { color: var(--accent); font-size: .68rem; font-weight: 600; letter-spacing: .12em; margin-bottom: .8rem; }
+.help-platform h3 { margin-bottom: .55rem; }
+.contact-inner { grid-template-columns: 1.15fr 1fr; gap: clamp(2.5rem,6vw,6rem); }
+.contact-intro h2 { max-width: 13ch; }
+.contact-inner h2 em { color: var(--accent); font-style: normal; }
+.contact-intro > p:last-child { max-width: 37ch; color: var(--stone); }
+.contact-details { gap: 1.5rem; }
+.contact-brief { max-width: 40ch; }
+.contact-email-button { align-self: flex-start; display: inline-flex; gap: 1.5rem; align-items: center; }
+.contact-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 2rem; padding-top: 1.5rem; border-top: 1px solid rgba(196,185,168,.3); }
+.contact-meta .contact-email { grid-column: 1 / -1; }
+.contact-item-label { color: var(--stone); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; }
+.contact-details .contact-address { font-size: clamp(1.1rem,2vw,1.4rem); text-decoration: none; }
+.contact-socials { padding-top: .25rem; }
+.contact-socials .social-row { gap: 1.5rem; margin-top: .6rem; flex-wrap: wrap; }
+.contact-socials a { font-size: .9rem; text-decoration: none; }
+.contact-socials a:hover, .contact-address:hover { color: var(--accent); }
+@media (max-width: 900px) { .contact-inner { grid-template-columns: 1fr; } .contact-intro h2 { max-width: 16ch; } }
+@media (max-width: 360px) { .contact-meta { gap: 1.25rem .75rem; } .contact-email-button { padding-inline: 1.2rem; gap: .75rem; } }
+
+.contact-intro h2 { max-width: none; }
+.contact-intro h2 em { color: var(--sage); white-space: nowrap; }
+.contact-details .contact-meta a, .contact-details .contact-socials a { color: var(--bg); }
+.contact-details .contact-meta a:hover, .contact-details .contact-socials a:hover { color: var(--stone); }
